<%- include('partials/header') %>

<link rel="stylesheet" href="/styles/home.css">

<section class="hero">

    <div class="hero-bg">

        <span class="blob blob1"></span>
        <span class="blob blob2"></span>
        <span class="blob blob3"></span>

        <div class="grid"></div>

    </div>

    <div class="hero-content">

        <div class="badge">
            <i class="fas fa-map-marker-alt"></i>
            Smart Civic Reporting Platform
        </div>

        <h1>
            Report Civic Issues.
            <br>
            <span>Build Better Cities.</span>
        </h1>

        <p>
            Upload photos of potholes, broken streetlights, garbage dumps,
            and other civic problems. Our AI analyzes the damage and routes
            it to the right authority automatically.
        </p>

        <div class="hero-buttons">

            <a href="/reports/new" class="btn-primary">
                <i class="fas fa-camera"></i>
                Report an Issue
            </a>

            <a href="/my-reports" class="btn-secondary">
                <i class="fas fa-list"></i>
                My Reports
            </a>

        </div>

    </div>

</section>

<section class="features">

    <h2>How It Works</h2>

    <p class="section-text">
        Reporting civic problems takes less than a minute.
    </p>

    <div class="feature-grid">

        <div class="feature-card">

            <div class="icon">
                <i class="fas fa-camera"></i>
            </div>

            <h3>Capture</h3>

            <p>
                Upload a clear image of the issue directly from your phone
                or computer.
            </p>

        </div>

        <div class="feature-card">

            <div class="icon">
                <i class="fas fa-map-marker-alt"></i>
            </div>

            <h3>Add Location</h3>

            <p>
                Automatically attach GPS coordinates, or type in the location
                manually.
            </p>

        </div>

        <div class="feature-card">

            <div class="icon">
                <i class="fas fa-landmark"></i>
            </div>

            <h3>AI-Powered Analysis</h3>

            <p>
                Our AI detects the damage type and severity, then generates
                a structured report for authorities to review.
            </p>

        </div>

    </div>

</section>

<section class="cta">

    <div class="cta-card">

        <h2>
            Together We Can Build Cleaner,
            Safer Streets.
        </h2>

        <p>
            Every report you submit helps improve your city for thousands
            of people. Start making a difference today.
        </p>

        <div class="cta-buttons">

            <a href="/reports/new" class="btn-primary">
                <i class="fas fa-camera"></i>
                Report an Issue
            </a>

            <a href="/register" class="btn-secondary">
                <i class="fas fa-user-plus"></i>
                Join Community
            </a>

        </div>

    </div>

</section>

<footer class="home-footer">

    <div class="footer-grid">

        <div>

            <h3>Community Hero</h3>

            <p>
                Smart civic reporting platform connecting citizens
                with local authorities.
            </p>

        </div>

        <div>

            <h4>Platform</h4>

            <a href="/">Home</a>
            <a href="/reports/new">Submit Issue</a>
            <a href="/my-reports">My Reports</a>

        </div>

    </div>

    <div class="footer-bottom">

        © 2026 Community Hero • Built for Better Cities

    </div>

</footer>

<script src="/js/home.js"></script>
