<%- include('partials/header.ejs') %>

<link rel="stylesheet" href="/styles/about.css">

<div class="about-page">

  <section class="about-intro">
    <h1>About Community Hero</h1>
    <p>
      Community Hero is a platform that lets citizens report civic issues —
      potholes, broken streetlights, garbage dumps, and more — directly to
      local authorities. Snap a photo, mark the location, and we handle the rest.
    </p>
  </section>

  <section class="divider-section">
    <div class="about-block">
      <h2>Our Mission</h2>
      <p>
        To make it effortless for citizens to report problems in their
        neighborhood and to give local authorities the tools to prioritize
        and resolve issues faster.
      </p>
    </div>

    <div class="about-block">
      <h2>How It Works</h2>
      <ol>
        <li>Take a photo of the issue and submit a report.</li>
        <li>Our system detects and classifies the problem automatically.</li>
        <li>Your report is added to the admin dashboard for review.</li>
        <li>Track the status of your report from your dashboard.</li>
      </ol>
    </div>
  </section>

</div>
