<%- include('partials/header') %>

<link rel="stylesheet" href="/styles/admin.css">

<main class="admin-page">
    <div class="admin-header">
        <h1>Admin dashboard</h1>
        <p>Reports ordered by severity, most critical first.</p>
    </div>

    <% if (reports.length === 0) { %>
        <p class="empty-state">No reports submitted yet.</p>
    <% } else { %>
        <div class="admin-grid">
            <% reports.forEach(function(r) { %>
                <% const sr = r.structured_report || {}; %>
                <% const imgSrc = r.annotated_image_url
                     ? '/' + r.annotated_image_url.replace(/\\/g, '/').replace('public/', '')
                     : '/uploads/placeholder.jpg'; %>
                <div class="admin-card">

                    <img
                        src="<%= imgSrc %>"
                        alt="Detected road damage with bounding boxes"
                        class="admin-thumb"
                        onclick="openLightbox('<%= imgSrc %>')"
                    >

                    <div class="admin-card-body">
                        <div class="admin-card-top">
                            <span class="severity-badge severity-<%= sr.severity || 'unknown' %>">
                                <%= sr.severity || 'unknown' %>
                            </span>
                            <span class="status-badge status-<%= r.status %>">
                                <%= r.status %>
                            </span>
                        </div>

                        <h3><%= sr.damage_type || 'Unknown issue' %></h3>
                        <p class="admin-summary"><%= sr.summary %></p>

                        <p class="admin-action">
                            <strong>Recommended action:</strong>
                            <%= sr.recommended_action %>
                        </p>

                        <p class="admin-meta">
                            <%= sr.location || 'Location unknown' %>
                            &middot;
                            <%= new Date(r.created_at).toLocaleString() %>
                        </p>

                        <% if (r.latitude && r.longitude) { %>
                            <a
                                class="maps-link"
                                href="https://www.google.com/maps?q=<%= r.latitude %>,<%= r.longitude %>"
                                target="_blank"
                                rel="noopener"
                            >
                                Open in Google Maps
                            </a>
                            <a
                                class="maps-link"
                                href="/admin/map?lat=<%= r.latitude %>&lng=<%= r.longitude %>"
                            >
                                View nearby reports &rarr;
                            </a>
                        <% } %>

                        <form action="/admin/reports/<%= r.id %>/status" method="POST" class="status-form">
                            <select name="status">
                                <option value="pending" <%= r.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                <option value="in_progress" <%= r.status === 'in_progress' ? 'selected' : '' %>>In progress</option>
                                <option value="resolved" <%= r.status === 'resolved' ? 'selected' : '' %>>Resolved</option>
                            </select>
                            <button type="submit">Update</button>
                        </form>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>

    <div id="lightboxOverlay" class="lightbox-overlay" onclick="closeLightbox()">
        <img id="lightboxImage" src="" alt="Full size report image">
    </div>
</main>

<script>
    function openLightbox(src) {
        document.getElementById('lightboxImage').src = src;
        document.getElementById('lightboxOverlay').classList.add('active');
    }
    function closeLightbox() {
        document.getElementById('lightboxOverlay').classList.remove('active');
    }
</script>