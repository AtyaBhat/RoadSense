<%- include('partials/header.ejs') %>

<link rel="stylesheet" href="/styles/auth.css">
<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

<div class="auth-page">
  <div class="auth-right" style="grid-column: 1 / -1;">
    <div class="auth-card">
      <h2>Forgot Password</h2>
      <p class="subtitle">Enter your email and we'll send you a reset link.</p>

      <% if (messages.error) { %>
        <p class="error-message"><%= messages.error %></p>
      <% } %>
      <% if (messages.success) { %>
        <p class="success-message"><%= messages.success %></p>
      <% } %>

      <form action="/forgot-password" method="POST">
        <div class="input-group">
          <span class="material-icons">mail</span>
          <input type="email" name="username" placeholder="Email" required />
        </div>

        <button type="submit" class="primary-btn">Send Reset Link</button>
      </form>

      <p class="switch-auth">Remembered your password? <a href="/login">Log in</a></p>
    </div>
  </div>
</div>
